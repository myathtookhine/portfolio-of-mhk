# Google Analytics 4. Paste the measurement ID from
# GA4 › Admin › Data streams › your web stream (looks like G-ABC1234XYZ).
# Left empty, the site simply runs without analytics.
# This file is committed on purpose: the ID is public (it ships in the page's
# JavaScript), and `npm run deploy` builds locally, so any clone needs it.
VITE_GA_MEASUREMENT_ID=G-PPK606RBFG

# Microsoft Clarity (session recordings and heatmaps). The project ID is in
# Clarity › Settings › Setup, in the snippet's clarity.ms/tag/<id> URL.
# Left empty, Clarity simply doesn't load.
VITE_CLARITY_PROJECT_ID=ywoaumfkna
